# daa — copy to .env and fill in. Nothing here is required to run the tests;
# every provider has an offline fake (see src/daa/jev/client.py::FakeJev).

TYPESAFE_API_KEY=            # https://typesafe.ai — powers every Jev judgment
DEEPSEEK_API_KEY=            # the conversational model
ASSEMBLYAI_API_KEY=          # cloud STT, used only AFTER the address gate fires
INWORLD_API_KEY=             # TTS
OPENAI_API_KEY=              # TTS fallback

# ── Feature flags ────────────────────────────────────────────────────────────
DAA_ALWAYS_ON=0              # 1 = hot mic gated by Jev; 0 = push-to-talk only
DAA_DRY_RUN=1                # 1 = tools resolve and narrate but never mutate
DAA_STT_LOCAL=1              # 1 = local STT feeds the gate; cloud only post-gate
