[{"text":"KDA open Safari.","ms":97,"wav":"audio\/00.wav"},{"text":"Open Safari.","ms":91,"wav":"audio\/01.wav"},{"text":"Can you find that PDF from last Tuesday?","ms":130,"wav":"audio\/02.wav"},{"text":"Put those three screenshots in the trash.","ms":107,"wav":"audio\/03.wav"},{"text":"What's on my calendar tomorrow?","ms":100,"wav":"audio\/04.wav"},{"text":"Actually make that the other one.","ms":98,"wav":"audio\/05.wav"},{"text":"No way.","ms":86,"wav":"audio\/06.wav"},{"text":"Never mind.","ms":93,"wav":"audio\/07.wav"},{"text":"Yeah do it.","ms":85,"wav":"audio\/08.wav"},{"text":"Don't do that.","ms":90,"wav":"audio\/09.wav"},{"text":"So I think we should ship it on Friday.","ms":107,"wav":"audio\/10.wav"},{"text":"Yet I'll send you the doc after stand up.","ms":109,"wav":"audio\/11.wav"},{"text":"Can you open the window? It's boiling in here.","ms":115,"wav":"audio\/12.wav"},{"text":"Hold on, let me share my screen.","ms":101,"wav":"audio\/13.wav"},{"text":"Sorry, you cut out, can you say that again?","ms":104,"wav":"audio\/14.wav"},{"text":"Next slide, please.","ms":89,"wav":"audio\/15.wav"},{"text":"Okay, so where did I put that file?","ms":102,"wav":"audio\/16.wav"},{"text":"Why is this so slow?","ms":107,"wav":"audio\/17.wav"},{"text":"Right, open the thing, then click there.","ms":113,"wav":"audio\/18.wav"},{"text":"Let me just delete all of this.","ms":100,"wav":"audio\/19.wav"},{"text":"And then you call dotmap on the result.","ms":110,"wav":"audio\/20.wav"},{"text":"To be or not to be, that is the question.","ms":108,"wav":"audio\/21.wav"},{"text":"Subscribe and hit the bell icon.","ms":102,"wav":"audio\/22.wav"},{"text":"In today's episode, we are going to look at...","ms":108,"wav":"audio\/23.wav"},{"text":"Hey Siri, what's the weather?","ms":91,"wav":"audio\/24.wav"},{"text":"Alexa, turn off the lights.","ms":91,"wav":"audio\/25.wav"},{"text":"MM.","ms":78,"wav":"audio\/26.wav"},{"text":"Ah.","ms":85,"wav":"audio\/27.wav"},{"text":"","ms":76,"wav":"audio\/28.wav"},{"text":"Open.","ms":79,"wav":"audio\/29.wav"},{"text":"it opened the downloads folder.","ms":101,"wav":"audio\/30.wav"},{"text":"Can you check my email?","ms":96,"wav":"audio\/31.wav"},{"text":"I was telling DAA to open it and it just sat there.","ms":119,"wav":"audio\/32.wav"},{"text":"DAA is the name of the assistant I've been building.","ms":117,"wav":"audio\/33.wav"},{"text":"Tell him I'll call back in 10.","ms":109,"wav":"audio\/34.wav"},{"text":"Remind me to call him back in 10.","ms":101,"wav":"audio\/35.wav"},{"wav":"audio\/36.wav","text":"What did you say?","ms":83},{"wav":"audio\/37.wav","text":"What did he say?","ms":87},{"wav":"audio\/38.wav","text":"Stop.","ms":88},{"wav":"audio\/39.wav","text":"Shut up.","ms":84}]