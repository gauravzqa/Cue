:77,"text":""},{"wav":"audio\/29.wav","ms":89,"text":"Open."},{"wav":"audio\/30.wav","ms":112,"text":"it opened the downloads folder."},{"wav":"audio\/31.wav","ms":99,"text":"Can you check my email?"},{"wav":"audio\/32.wav","ms":120,"text":"I was telling DAA to open it and it just sat there."},{"wav":"audio\/33.wav","ms":111,"text":"DAA is the name of the assistant I've been building."},{"wav":"audio\/34.wav","ms":101,"text":"Tell him I'll call back in 10."},{"wav":"audio\/35.wav","ms":97,"text":"Remind me to call him back in 10."},{"wav":"audio\/36.wav","ms":86,"text":"What did you say?"},{"wav":"audio\/37.wav","ms":88,"text":"What did he say?"},{"wav":"audio\/38.wav","ms":84,"text":"Stop."},{"wav":"audio\/39.wav","ms":89,"text":"Shut up."}]